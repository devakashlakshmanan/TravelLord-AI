# =============================================================================
# TravelLord AI — Environment Variables
# Copy this file to .env.local and fill in your actual credentials.
# NOTE: Never commit .env.local to version control!
# =============================================================================

# 1. Supabase Project Settings (https://supabase.com -> Project -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# 2. Supabase Server-side Service Role Key (Keep private! Used only in server API routes)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Groq Cloud API Key (https://console.groq.com/keys)
# Used strictly for phrasing natural language explanations of deterministic safety decisions
GROQ_API_KEY=gsk_your-groq-api-key
